# Frontend env (Vite). Copy to .env.local for development.
# These are baked into the build at `npm run build`.

# API base — leave blank in dev and prod (Pages Functions live on the
# same origin as the SPA). Only set this if you're running the SPA
# against a remote backend for some reason.
VITE_API_BASE=

# Cloudflare Turnstile site key. Use the always-passing test key in dev.
# Test site key (passes any token): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Destination URLs (TIMS will provide finals).
# Tribal Habits e-learning registration URL. If a `registration_token` (or
# `token`) query param is present, the frontend displays it as a copy-able
# registration code on the thank-you screen, and Tribal Habits auto-fills
# it on the registration page.
VITE_TRIBAL_HABITS_ENROL_URL=https://tims.tribalhabits.com/accounts/register?registration_token=champions-challenge
VITE_WORKSHOP_ENQUIRY_URL=mailto:connect@tims.org.au?subject=Cybersecurity%20Champions%20Workshop
VITE_SCAMWATCH_SUBSCRIBE_URL=https://www.scamwatch.gov.au/about-us/news-and-alerts/subscribe-to-scam-alert-emails
VITE_PRIMARY_DOMAIN=cybersecurity.tims.org.au
